# ── Server ────────────────────────────────────────────────────────────────
PORT=4000

# ── Database (PostgreSQL) ───────────────────────────────────────────────────
# Matches docker-compose.yml (user: myuser, db: mydatabase, host port 5433).
DATABASE_URL=postgresql://myuser:mysecretpassword@localhost:5433/mydatabase

# ── Auth ────────────────────────────────────────────────────────────────────
# Generate a long random string, e.g. `openssl rand -hex 32`.
JWT_SECRET_KEY=change-me-to-a-long-random-secret
TOKEN_HEADER_KEY=Authorization

# ── Redis ─────────────────────────────────────────────────────────────────
# Matches docker-compose.yml (requirepass MySecurePassword123).
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=MySecurePassword123

# ── GitHub webhook ──────────────────────────────────────────────────────────
# Optional. When set, incoming /webhooks/github requests MUST carry a valid
# X-Hub-Signature-256 header (the secret you configure in the GitHub webhook UI).
# Leave empty to disable signature verification (local development only).
GITHUB_WEBHOOK_SECRET=

# ── Deployment pipeline (optional overrides) ────────────────────────────────
# Port the deployed app listens on INSIDE its container, and its health path.
DEPLOY_APP_PORT=3000
DEPLOY_HEALTH_PATH=/health
# Per-container resource limits (isolation): memory and CPU share.
DEPLOY_CONTAINER_MEMORY=512m
DEPLOY_CONTAINER_CPUS=1
# How many deployments the worker runs in parallel.
WORKER_CONCURRENCY=3

# ── Frontend CORS ───────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Defaults to the Vite dev server.
CORS_ORIGIN=http://localhost:5173
